# Sao chép thành .env rồi điền giá trị thật: cp .env.example .env
# Tệp .env không bao giờ được commit.

# --- PostgreSQL ---
POSTGRES_USER=shopflow
POSTGRES_DB=shopflow
# Sinh chuỗi ngẫu nhiên, ví dụ: openssl rand -base64 24
POSTGRES_PASSWORD=doi-gia-tri-nay
POSTGRES_PORT=5432

# Chuỗi kết nối dùng khi chạy lệnh Prisma trực tiếp trên máy chủ.
# Viết USER và PASSWORD in hoa có chủ đích: công cụ quét secret bắt mọi chuỗi
# kết nối trông như thật, kể cả trong tệp mẫu. Điền giá trị thật vào .env.
# Bên trong Docker Compose, service api tự dựng giá trị riêng trỏ tới hostname `db`.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/shopflow

# --- Ánh xạ user cho container ---
# Lấy giá trị của máy bạn bằng: id -u  và  id -g
# Cần thiết khi Docker chạy trực tiếp trên Linux hoặc WSL, để tệp do container
# tạo ra vẫn sửa được từ máy chủ. Trên macOS và Windows dùng Docker Desktop
# thì giá trị này không có tác dụng, để nguyên cũng được.
DOCKER_UID=1000
DOCKER_GID=1000

# --- Theo dõi thay đổi tệp ---
# Đặt true khi hot reload không hoạt động, thường xảy ra trên macOS và Windows
# vì bind mount ở đó không phát sinh sự kiện inotify đáng tin cậy.
# Trên Linux và WSL để false vì polling tốn CPU không cần thiết.
WATCH_POLLING=false

# --- Redis ---
# Dùng cho rate limit. Đây là cổng publish ra máy chủ; bên trong Compose luôn là 6379.
# Đổi nếu máy đã có Redis khác chiếm cổng — chuyện thường gặp khi chạy nhiều dự án.
REDIS_PORT=6379

# --- Xác thực ---
# Khoá ký access token. Sinh chuỗi ngẫu nhiên: openssl rand -base64 48
# Đổi khoá này làm mọi phiên đang mở mất hiệu lực.
JWT_SECRET=doi-gia-tri-nay

# --- Cổng publish ra máy chủ ---
# Đổi nếu máy đã có dự án khác chiếm cổng — chuyện thường gặp khi chạy nhiều dự án.
# Bên trong Compose, api luôn là 3000 và web luôn là 5173.
API_PORT=3000
WEB_PORT=5173

