{
      "tabWidth": 6,
      "useTabs": false,
      "printWidth": 140,
      "semi": true,
      "singleQuote": true,
      "quoteProps": "as-needed",
      "trailingComma": "all",
      "arrowParens": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "endOfLine": "lf",
      "vueIndentScriptAndStyle": false,
      "htmlWhitespaceSensitivity": "css",
      "singleAttributePerLine": false,
      "overrides": [
            {
                  "files": ["*.yml", "*.yaml"],
                  "options": { "tabWidth": 2 }
            },
            {
                  "files": ["*.md"],
                  "options": { "tabWidth": 2 }
            }
      ]
}
