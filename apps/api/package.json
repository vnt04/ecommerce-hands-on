{
      "name": "@shopflow/api",
      "version": "0.0.0",
      "private": true,
      "type": "module",
      "scripts": {
            "build": "prisma generate && nest build",
            "dev": "prisma generate && nest start --watch",
            "start": "node dist/main.js",
            "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
            "test": "vitest run --coverage",
            "test:int": "prisma generate && vitest run --config vitest.int.config.ts"
      },
      "dependencies": {
            "@nestjs/common": "^11.1.29",
            "@nestjs/core": "^11.1.29",
            "@nestjs/platform-express": "^11.1.29",
            "@prisma/adapter-pg": "^7.9.1",
            "@prisma/client": "^7.9.1",
            "@shopflow/shared": "workspace:*",
            "express": "^5.2.1",
            "nestjs-pino": "^4.6.1",
            "pg": "^8.23.0",
            "pino": "^10.3.1",
            "pino-http": "^11.0.0",
            "reflect-metadata": "^0.2.2",
            "rxjs": "^7.8.2",
            "zod": "^4.4.3"
      },
      "devDependencies": {
            "@nestjs/cli": "^11.0.24",
            "@nestjs/schematics": "^11.1.0",
            "@testcontainers/postgresql": "^12.1.0",
            "@types/express": "^5.0.6",
            "@types/node": "^22.19.0",
            "@types/pg": "^8.23.1",
            "@vitest/coverage-v8": "^3.2.7",
            "dotenv": "^17.4.2",
            "prisma": "^7.9.1",
            "testcontainers": "^12.1.0",
            "typescript": "^5.9.3",
            "vitest": "^3.2.7"
      }
}
